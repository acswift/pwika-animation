sole.log('func_name13: '+arg1+':'+arg2+':'+arg3+':'+arg4+':'+arg5+':'+arg6);\r\n}\r\n\r\nfunction func_name14(){\r\n  console.log('func_name14');\r\n}", "order": 0, "enabled": true}}, {"model": "svija.additionalscript", "pk": 194, "fields": {"page": 184, "type": "body JS", "name": "make triggers visible", "content": "triggers_visible=true;", "order": 0, "enabled": true}}, {"model": "svija.additionalscript", "pk": 195, "fields": {"page": 185, "type": "body JS", "name": "make triggers visible", "content": "triggers_visible=true;", "order": 0, "enabled": true}}, {"model": "svija.additionalscript", "pk": 199, "fields": {"page": 189, "type": "body JS", "name": "event function name2", "content": "function func_name2(arg){\r\n    alert(arg);\r\n}\r\n\r\nfunction func_name3(arg){\r\n    alert(arg);\r\n}\r\n\r\nfunction func_name4(arg){\r\n    alert(arg);\r\n}", "order": 0, "enabled": true}}, {"model": "svija.additionalscript", "pk": 200, "fields": {"page": 190, "type": "body JS", "name": "event function name2", "content": "function func_name2(arg){\r\n    alert(arg);\r\n}\r\n\r\nfunction func_name3(arg){\r\n    alert(arg);\r\n}\r\n\r\nfunction func_name4(arg){\r\n    alert(arg);\r\n}", "order": 0, "enabled": true}}, {"model": "svija.additionalscript", "pk": 201, "fields": {"page": 196, "type": "HTML", "name": "anchors", "content": "<a id=\"anchor1\" name=\"anchor1\"> </a>\r\n<a id=\"anchor2\" name=\"anchor2\"> </a>\r\n<a id=\"anchor3\" name=\"anchor3\"> </a>\r\n<a id=\"anchor4\" name=\"anchor4\"> </a>\r\n<a id=\"anchor5\" name=\"anchor5\"> </a>\r\n<a id=\"anchor6\" name=\"anchor6\"> </a>\r\n<a id=\"anchor7\" name=\"anchor7\"> </a>", "order": 2, "enabled": true}}, {"model": "svija.additionalscript", "pk": 202, "fields": {"page": 196, "type": "CSS", "name": "anchor CSS", "content": "#anchor1, #anchor2, #anchor3, #anchor4,\r\n#anchor5, #anchor6, #anchor7{\r\n position:absolute;\r\n display:block;\r\n padding:20px;\r\n z-index: 10000;\r\n background-color:lime;\r\n}\r\n\r\n#anchor1{ left:400rem; top:   0rem; }\r\n#anchor2{ left:400rem; top: 500rem; }\r\n#anchor3{ left:400rem; top:1000rem; }\r\n#anchor4{ left:400rem; top:1500rem; }\r\n#anchor5{ left:400rem; top:2000rem; }\r\n#anchor6{ left:400rem; top:2500rem; }\r\n#anchor7{ left:400rem; top:3000rem; }", "order": 1, "enabled": true}}, {"model": "svija.additionalscript", "pk": 203, "fields": {"page": 204, "type": "CSS", "name": "horizontal scrolling", "content": "html, body{\r\n  overflow-x:hidden;  /*  so page doesn't scroll up slightly */\r\n  overflow-y:hidden;  /*  for horizontal scrolling           */\r\n}\r\n\r\nbody{\r\n  position:static;\r\n}", "order": 1, "enabled": true}}, {"model": "svija.additionalscript", "pk": 204, "fields": {"page": 204, "type": "body JS", "name": "horizontal scrolling", "content": "var speed = 4\r\nvar scrollElement = document.body\r\n\r\nscrollElement.addEventListener(\"wheel\", (evt) => {\r\n  evt.preventDefault()\r\n  evt.stopPropagation()\r\n  scrollElement.scrollLeft += evt.deltaY * speed\r\n});", "order": 2, "enabled": true}}, {"model": "svija.additionalscript", "pk": 205, "fields": {"page": 205, "type": "CSS", "name": "horizontal scrolling", "content": "html, body{\r\n  overflow-x:hidden;  /*  so page doesn't scroll up slightly */\r\n  overflow-y:hidden;  /*  for horizontal scrolling           */\r\n}\r\n\r\nbody{\r\n  position:static;\r\n}", "order": 1, "enabled": true}}, {"model": "svija.additionalscript", "pk": 206, "fields": {"page": 205, "type": "body JS", "name": "horizontal scrolling", "content": "const speed = 4\r\nconst page  = document.body\r\n\r\npage.addEventListener(\"wheel\", (evt) => {\r\n  evt.preventDefault()\r\n  evt.stopPropagation()\r\n  page.scrollLeft += evt.deltaY * speed\r\n});", "order": 2, "enabled": true}}, {"model": "svija.additionalscript", "pk": 207, "fields": {"page": 206, "type": "body JS", "name": "demo script", "content": "function func_name10(){\r\n  alert('executing script func_name10()');\r\n}", "order": 0, "enable